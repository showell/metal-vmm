-- **MASTER MERGED, THE QUEUE'S FILES BY THEIR PARTS** (QUEUE 254, 258):
-- `git_merge`, and on a conflict in the queue's four files alone, the merge
-- again with each written three ways from the merge base, HEAD's and
-- `ref`'s: FEEDBACK.md by its entries (`feedback_merge`), QUEUE.md by its
-- items (`queue_merge`), the two archives by their lines (`lines_merge`). An entry `ref` let go stays gone: one its
-- archive holds, and one its last `history` changes to FEEDBACK.md took
-- out and never put back (the box lets some go without an archive line).
-- A conflict in any other file, an entry changed on both sides, or a
-- FEEDBACK that breaks its grammar after (`queue_check`) undoes the merge
-- and stops, naming it. From this checkout's root:
--
--     shale .shale/merge_master.shale
--     shale .shale/merge_master.shale ref=origin/master fetch=no history=30
--
-- budget: steps=900000000

const REF = arg("ref", "origin/master")
const HISTORY = arg("history", "30")

if arg("fetch", "yes") == "yes" then git_fetch(".") end

function merge_plain(ref)
  return git_merge(".", ref)
end

-- The grammar's first break, as a stop, undoing a merge underway.
function refuse_unless_clean(undo)
  local bad = queue_check()
  if #bad == 0 then return nil end
  if undo then git_call(".", {"merge", "--abort"}, nil, false, nil) end
  fail("merge_master: after the merge, the queue's files break their grammar (" .. #bad .. " in all): " .. bad[1])
end

local r = attempt(merge_plain, REF)
if r.ok then
  refuse_unless_clean(false)
  print("merge_master: " .. REF .. " merged, no conflict: " .. r.value)
  return nil
end
local at = find(r.error, ": conflicts in ")
if at == nil then fail(r.error) end
local named = sub(r.error, at + 15)
named = sub(named, 1, find(named, "; the merge is undone") - 1)
const MINE = {["FEEDBACK.md"] = true, ["FEEDBACK-ARCHIVE.md"] = true, ["QUEUE.md"] = true, ["QUEUE-ARCHIVE.md"] = true}
local open = {}
for p in split(named, ", ") do
  if not has_key(MINE, p) then fail("merge_master: " .. p .. " conflicts (" .. named .. "): merge it yourself; this tool merges the queue's four files alone") end
  open[p] = true
end

local base = trim(git_call(".", {"merge-base", "HEAD", REF}, nil, true, nil).out)
-- Each file's three sides; a file a side lacks is "".
function side(rev, p)
  local t = attempt(git_show, ".", rev .. ":" .. p)
  if t.ok then return t.value end
  return ""
end
function sides(p, base)
  return {base = side(base, p), ours = side("HEAD", p), theirs = side(REF, p)}
end
-- The archives first: the queue's merge reads its archive's numbers.
local merged = {}
local said = {}
for p in {"FEEDBACK-ARCHIVE.md", "QUEUE-ARCHIVE.md"} do
  if has_key(open, p) then
    local s = sides(p, base)
    merged[p] = lines_merge(s.base, s.ours, s.theirs)
    push(said, p .. " by its lines")
  end
end
if has_key(open, "QUEUE.md") then
  local s = sides("QUEUE.md", base)
  local archive = get(merged, "QUEUE-ARCHIVE.md", side(REF, "QUEUE-ARCHIVE.md"))
  merged["QUEUE.md"] = queue_merge(s.base, s.ours, s.theirs, archive)
  push(said, "QUEUE.md by its items (" .. #queue_parse(merged["QUEUE.md"]).items .. ")")
end
if has_key(open, "FEEDBACK.md") then
  -- What `ref` let go: the headings its recent changes took out, less the
  -- ones it holds now, as archive lines, beside the archive's own.
  local s = sides("FEEDBACK.md", base)
  local now = {}
  for e in feedback_split(s.theirs).entries do now[e.heading] = true end
  local let_go = {}
  local log = git_call(".", {"log", "-n", HISTORY, "-p", "-U0", "--format=", REF, "--", "FEEDBACK.md"}, nil, true, nil).out
  for l in lines(log) do
    if starts_with(l, "-## ") and not has_key(now, sub(l, 5)) then push(let_go, "- " .. sub(l, 5)) end
  end
  local archive = get(merged, "FEEDBACK-ARCHIVE.md", side(REF, "FEEDBACK-ARCHIVE.md")) .. "\n" .. join(let_go, "\n") .. "\n"
  merged["FEEDBACK.md"] = feedback_merge(s.base, s.ours, s.theirs, archive)
  push(said, "FEEDBACK.md by its entries (" .. #feedback_split(merged["FEEDBACK.md"]).entries .. "; " .. #let_go .. " headings " .. REF .. " let go)")
end

-- The merge again, this time left open for those files' text.
local m = run({"git", "-C", real(""), "-c", "color.ui=never", "merge", "-q", "--no-edit", "--no-commit", REF}, {timeout_ms = 60000, env = {GIT_TERMINAL_PROMPT = "0"}, head = 10, tail = 10})
local again = git_call(".", {"diff", "--name-only", "--diff-filter=U"}, nil, true, nil).out
for p in lines(again) do
  if not has_key(merged, p) then
    git_call(".", {"merge", "--abort"}, nil, false, nil)
    fail("merge_master: the second merge left `" .. p .. "` open, which the first did not; undone")
  end
end
for p in keys(merged) do
  replace(p, merged[p])
  git_call(".", {"add", p}, nil, false, nil)
end
refuse_unless_clean(true)
git_call(".", {"commit", "-q", "--no-edit"}, nil, false, nil)
print("merge_master: " .. REF .. " merged, " .. join(said, ", ") .. ": " .. git_head("."))
