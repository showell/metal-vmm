# a game session made, then a move in it (metal-vmm QUEUE 126): client 1
# makes session 2 (the setup made 1), and client 2, asking only after client
# 1 was answered (PEER_IN_TURN), moves in it. A move in a session that is not
# there is a 404 (game.zig), so request 1 damaging request 2 shows. Derived
# from game.zig, not yet run on a guest.
PEER_CLIENTS=2
PEER_IN_TURN=1
PEER_REQUEST=new-session.http,game-action-2.http
EXPECT=200,204
# client 1's session never made (its answer cost by a fault): the move is a 404
UNMADE=404
